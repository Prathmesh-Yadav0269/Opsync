# OPSYNC Backend Environment Configuration Example
# Development: local MongoDB and local ports
# Production: MongoDB Atlas M0 cluster, Render Web Service

# Server Port (Render sets this automatically via process.env.PORT)
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas in production: mongodb+srv://<user>:<password>@cluster.mongodb.net/opsync?retryWrites=true&w=majority)
MONGODB_URI=mongodb://127.0.0.1:27017/opsync

# JWT Secret & Expiry (Min 32 characters, use strong cryptographic random in production)
JWT_SECRET=replace_with_strong_random_secret_min32chars_in_production!
JWT_EXPIRES_IN=7d

# Frontend Allowed Origin (Vercel deployment URL in production: https://<your-project>.vercel.app)
CLIENT_URL=http://localhost:5173

# File Upload Configuration
MAX_FILE_SIZE_MB=10

# Initial Admin Bootstrap (Used by 'npm run bootstrap:admin')
ADMIN_NAME=Opsync Administrator
ADMIN_EMAIL=admin@opsync.local
ADMIN_PASSWORD=change_this_admin_password_in_production!
